{
  "name": "bb-plugin-routerai-managed-profile",
  "version": "0.0.3",
  "description": "Managed OpenCode profile for RouterAI in bb: cached model catalog, model picking with reasoning levels and ruble prices, inline OPENCODE_CONFIG_CONTENT delivered through bb's ACP bridge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladimirovichivan/bb-routerai-models.git"
  },
  "homepage": "https://github.com/vladimirovichivan/bb-routerai-models#readme",
  "bugs": {
    "url": "https://github.com/vladimirovichivan/bb-routerai-models/issues"
  },
  "keywords": [
    "bb-plugin",
    "bb",
    "routerai",
    "opencode",
    "acp",
    "provider",
    "models",
    "reasoning"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.50",
    "bbPluginSdk": ">=0.6.157"
  },
  "scripts": {
    "build": "bb plugin build",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "bb": {
    "name": "RouterAI Managed Profile",
    "description": "Managed OpenCode profile for RouterAI: cached model catalog, model picking with reasoning levels and RUB prices, inline OPENCODE_CONFIG_CONTENT delivered through bb's own ACP provider. Never touches the user's opencode.json.",
    "branding": {
      "icon": "AiContentGenerator01"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "routerai-managed",
        "displayName": "RouterAI Managed"
      }
    ],
    "app": "./app.tsx"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  }
}
